# Copy to .env.production on the Droplet. Never commit the copied file.
APP_ENV=production
# Generate with: openssl rand -hex 32
FLASK_SECRET_KEY=replace-with-a-new-64-hex-character-secret
# Create a fresh key in Google AI Studio; do not reuse a former team key.
GEMINI_API_KEY=replace-with-a-new-gemini-key
# Used by Caddy for Let's Encrypt expiry notices.
CADDY_EMAIL=your-email@example.com
